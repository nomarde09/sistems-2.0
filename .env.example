# Пример настроек системы заявок. Скопируйте в .env и поменяйте значения.
# Файл .env НЕ попадает в Git.
#
# Пароли сотрудников здесь НЕ хранятся: в базе лежат только их хеши (argon2).
# Выдать всем новые временные пароли (сотрудник сменит при первом входе):
#   python app.py --novye-paroli

# Длинная случайная строка (не короче 32 символов). Без неё входы слетают при каждом перезапуске.
SECRET_KEY=

# Логины (можно русскими буквами, регистр не важен). Без строки логин = rukovoditel, manager1...
# LOGIN_RUKOVODITEL=Фарух
# LOGIN_MANAGER1=Яна
# LOGIN_MANAGER2=Умида
# LOGIN_BRIGADA1=Иван
# LOGIN_BRIGADA2=Жахонгир
# Имена для показа на сайте. Без строки показывается должность.
# NAME_RUKOVODITEL=Фарух
# NAME_MANAGER1=Яна
# NAME_MANAGER2=Умида
# NAME_BRIGADA1=Иван
# NAME_BRIGADA2=Жахонгир

# Часовой пояс: сколько часов прибавить к UTC (Москва = 3, Астана = 5).
TZ_OFFSET_HOURS=5

# ---- На хостинге ----
# 1 — сайт работает по https (обязательно в интернете). Тогда cookie только по https и HSTS.
COOKIE_SECURE=0
# 1 — сайт стоит за прокси хостинга (почти всегда так): берём настоящий IP посетителя.
TRUST_PROXY=0
# Адрес(а) сайта через запятую — запросы на чужие адреса отклоняются. Пример: zayavki.example.kz
ALLOWED_HOSTS=

# Резервные копии: раз в день сами, хранятся 14 дней. 0 — выключить.
BACKUP_AUTO=1
# Папка для копий (по умолчанию data/backups). Лучше папка вне сайта.
# BACKUP_DIR=

# Технический раздел /tech (только чтение). Включить и получить пароль:
#   python app.py --tech-parol
# В .env запишется только хеш пароля.
SUPERADMIN_LOGIN=
SUPERADMIN_PASSWORD_HASH=
